{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "outDir": "./dist",
    "declaration": true,
    "noEmit": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", ".eslintrc.js", "jest.setup.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "src/w3cmedia/shakaplayer/dist/**/*",
    "shaka-setup/**/*"
  ]
}
